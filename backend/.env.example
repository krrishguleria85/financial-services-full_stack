# Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="file:./dev.db"
# For PostgreSQL, use: DATABASE_URL="postgresql://user:password@localhost:5432/financial_services"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="24h"

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# File Upload (Local fallback directory)
MAX_FILE_SIZE_MB=10
UPLOAD_DIR="./uploads"

# Cloudflare R2 Storage (Private Document Storage)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="financial-services-private-docs"
# Optional explicit endpoint; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT="https://your_cloudflare_account_id.r2.cloudflarestorage.com"

# YouTube API (optional - leave empty to use manual video management)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# Email (Resend)
RESEND_API_KEY="re_placeholder_api_key"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# WhatsApp (configurable from admin settings)
# WHATSAPP_NUMBER=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
